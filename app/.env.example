# =============================================================
# متغیرهای محیطی — کپی به .env (برای توسعه)
#
# ⚠️ .env در .gitignore است و هرگز commit نمی‌شود.
#
# ⚠️ مقدارها را اینجا قرار ندهید. برای استقرار روی هاست،
#    همین دو کلید را در داشبورد هاست (Environment Variables)
#    وارد کنید.
#
# گرفتن مقدارها:
#    Supabase Dashboard → Project Settings → API
#    - Project URL        → VITE_SUPABASE_URL
#    - anon public        → VITE_SUPABASE_ANON_KEY
#
# نکتهٔ امنیتی: anon key عمومی است و در خروجی build داخل
# مرورگر می‌رود؛ RLS لایهٔ محافظ واقعی است. key دیگری (service_role)
# را هرگز در اینجا یا در هاست قرار ندهید.
# =============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
